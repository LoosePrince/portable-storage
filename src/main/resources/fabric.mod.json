{
	"schemaVersion": 1,
	"id": "portablestorage",
	"version": "${version}",
	"name": "Portable Storage",
	"description": "在玩家背包UI上方添加仓库界面",
	"authors": [
		"LoosePrince"
	],
	"contact": {
		"homepage": "https://github.com/LoosePrince/portable-storage",
		"sources": "https://github.com/LoosePrince/portable-storage",
		"issues": "https://github.com/LoosePrince/portable-storage/issues"
	},
	"license": "MIT",
	"icon": "assets/portablestorage/icon.png",
	"accessWidener": "portablestorage.accesswidener",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.portablestorage.PortableStorage"
		],
		"client": [
			"com.portablestorage.PortableStorageClient"
		],
		"cardinal-components-scoreboard": [
			"com.portablestorage.component.ModComponentRegistration"
		],
		"jei_mod_plugin": [
			"com.portablestorage.jei.PortableStorageJeiPlugin"
		],
		"modmenu": [
			"com.portablestorage.client.PortableStorageModMenuApi"
		]
	},
	"custom": {
		"cardinal-components": [
			"portablestorage:warehouse"
		],
		"modmenu": {
			"links": {
				"portablestorage.modmenu.qq_group": "https://jq.qq.com/?_wv=1027&k=2oUF0gg9"
			}
		}
	},
	"mixins": [
		"portablestorage.mixins.json",
		{
			"config": "portablestorage.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16",
		"minecraft": "~26.1",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"yet_another_config_lib_v3": ">=3.9.2+26.1-fabric"
	}
}