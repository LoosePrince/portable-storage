{
	"schemaVersion": 1,
	"id": "portablestorage",
	"version": "${version}",
	"name": "Portable Storage",
	"description": "在玩家背包UI上方添加仓库界面",
	"authors": [
		"LoosePrince"
	],
	"contact": {
		"homepage": "https://github.com/LoosePrince/portable-storage",
		"sources": "https://github.com/LoosePrince/portable-storage"
	},
	"license": "MIT",
	"icon": "assets/portablestorage/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.portablestorage.PortableStorage"
		],
		"client": [
			"com.portablestorage.PortableStorageClient"
		],
		"cardinal-components-world": [
			"com.portablestorage.component.ModComponentRegistration"
		]
	},
	"custom": {
		"cardinal-components": [
			"portablestorage:warehouse"
		]
	},
	"mixins": [
		"portablestorage.mixins.json",
		{
			"config": "portablestorage.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16",
		"minecraft": "~1.21",
		"java": ">=21",
		"fabric-api": "*"
	}
}